{
  "ros.distro": "lyrical",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/install/**": true,
    "**/log/**": true
  },
  "search.exclude": {
    "**/build": true,
    "**/install": true,
    "**/log": true,
    "src/tortoisebot/third_party": true
  }
}
